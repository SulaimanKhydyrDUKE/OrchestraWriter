# Copy to .env and fill in. .env is gitignored.

# --- AWS ---
AWS_REGION=us-east-1
# Optional. Leave blank if ~/.aws/credentials is configured; the SDK finds those automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Postgres ---
# Option A: Aurora with IAM auth (no password; a token is generated per connection).
DB_HOST=your-cluster.cluster-xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSL=true
# TLS verification is on by default. Set DB_SSL_VERIFY=false only while debugging.
# DB_SSL_CA_PATH adds a CA bundle to the system roots; only needed for RDS-private-CA clusters.
DB_SSL_VERIFY=true
DB_SSL_CA_PATH=
# Option B: local Docker Postgres (see README "Run locally without AWS"):
#   docker run -d --name orchestra-pg -e POSTGRES_PASSWORD=orchestra -e POSTGRES_DB=orchestra -p 5433:5432 postgres:16
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=orchestra
# DB_USER=postgres
# DB_PASSWORD=orchestra
# DB_SSL=false

# --- S3 ---
S3_AUDIO_BUCKET=
# Leave both empty for real AWS S3. docker-compose.yml sets them to point at the local S3Mock.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# --- Auth (Better Auth) ---
# Any long random string in production: `openssl rand -base64 32`. Optional in development.
BETTER_AUTH_SECRET=
# Public origin of the site. Defaults to http://localhost:PORT. In production this is the
# App Runner URL, e.g. https://xxxx.us-east-1.awsapprunner.com
BETTER_AUTH_URL=
# Google sign-in. Leave blank to hide the button. Create a "Web application" OAuth client in
# Google Cloud Console and register <BETTER_AUTH_URL>/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server ---
PORT=3000
NODE_ENV=development
